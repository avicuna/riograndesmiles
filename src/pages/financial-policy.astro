---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import FinalCta from '../components/FinalCta.astro';

const t = useTranslations('en');
---

<BaseLayout
  title="Financial Policy | Rio Grande Smiles"
  description="Our financial policy explained clearly. Payment is due at time of service. We accept cash, credit, debit, and checks. Insurance billing and cancellation policy details."
  locale="en"
  canonicalPath="/financial-policy"
>
  {/* Hero Section */}
  <section class="bg-bg-warm border-b border-line py-12">
    <div class="max-w-content mx-auto px-6 text-center">
      <h1 class="font-display text-3xl md:text-4xl font-medium text-ink mb-4">
        {t('financialPolicyPage.title')}
      </h1>
    </div>
  </section>

  {/* Our Policy */}
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-ink mb-6">
        {t('financialPolicyPage.policyHeading')}
      </h2>
      <p class="text-lg text-ink-2 leading-relaxed mb-8">
        {t('financialPolicyPage.policyIntro')}
      </p>

      {/* Payment Methods */}
      <div class="bg-bg-warm rounded-lg p-8 mb-8">
        <h3 class="font-medium text-xl text-ink mb-4">
          {t('financialPolicyPage.paymentMethodsHeading')}
        </h3>
        <ul class="space-y-3">
          {t.list('financialPolicyPage.paymentMethods').map((method) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-ink-2">{method}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* Insurance Billing */}
  <section class="py-16 bg-bg-warm">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-ink mb-6">
        {t('financialPolicyPage.insuranceBillingHeading')}
      </h2>
      <div class="space-y-4">
        <p class="text-lg text-ink-2 leading-relaxed">
          {t('financialPolicyPage.insuranceBillingP1')}
        </p>
        <p class="text-lg text-ink-2 leading-relaxed">
          {t('financialPolicyPage.insuranceBillingP2')}
        </p>
      </div>
    </div>
  </section>

  {/* Cancellation Policy */}
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-ink mb-6">
        {t('financialPolicyPage.cancellationHeading')}
      </h2>
      <div class="space-y-4">
        <p class="text-lg text-ink-2 leading-relaxed">
          {t('financialPolicyPage.cancellationP1')}
        </p>
        <p class="text-lg text-ink-2 leading-relaxed">
          {t('financialPolicyPage.cancellationP2')}
        </p>
      </div>
    </div>
  </section>

  {/* Questions Callout */}
  <section class="py-16 bg-bg-warm">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-display text-2xl font-medium text-ink mb-4">
        {t('financialPolicyPage.questionsHeading')}
      </h2>
      <p class="text-ink-2 mb-8">
        {t('financialPolicyPage.questionsDescription')}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="tel:+15058771113"
          class="btn btn-primary"
        >
          <Icon name="phone" class="w-[18px] h-[18px]" />
          (505) 877-1113
        </a>
        <a
          href="mailto:emersonvicunadds@gmail.com"
          class="btn btn-line"
        >
          <Icon name="mail" class="w-[18px] h-[18px]" />
          Email Us
        </a>
      </div>
    </div>
  </section>

  {/* Final CTA */}
  <FinalCta locale="en" />
</BaseLayout>
