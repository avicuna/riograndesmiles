---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import FinalCta from '../components/FinalCta.astro';

const t = useTranslations('en');
---

<BaseLayout
  title="Financial Policy | Rio Grande Smiles"
  description="Our financial policy explained clearly. Payment is due at time of service. We accept cash, credit, debit, and checks. Insurance billing and cancellation policy details."
  locale="en"
  canonicalPath="/financial-policy"
>
  {/* Hero Section */}
  <section class="bg-primary-50 py-12">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h1 class="font-display text-3xl md:text-4xl font-bold text-neutral-900 mb-4">
        {t('financialPolicyPage.title')}
      </h1>
    </div>
  </section>

  {/* Our Policy */}
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-neutral-900 mb-6">
        {t('financialPolicyPage.policyHeading')}
      </h2>
      <p class="text-lg text-neutral-700 leading-relaxed mb-8">
        {t('financialPolicyPage.policyIntro')}
      </p>

      {/* Payment Methods */}
      <div class="bg-neutral-50 rounded-xl p-8 mb-8">
        <h3 class="font-semibold text-xl text-neutral-900 mb-4">
          {t('financialPolicyPage.paymentMethodsHeading')}
        </h3>
        <ul class="space-y-3">
          {t('financialPolicyPage.paymentMethods').map((method: string) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-neutral-700">{method}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* Insurance Billing */}
  <section class="py-16 bg-neutral-50">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-neutral-900 mb-6">
        {t('financialPolicyPage.insuranceBillingHeading')}
      </h2>
      <div class="space-y-4">
        <p class="text-lg text-neutral-700 leading-relaxed">
          {t('financialPolicyPage.insuranceBillingP1')}
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed">
          {t('financialPolicyPage.insuranceBillingP2')}
        </p>
      </div>
    </div>
  </section>

  {/* Cancellation Policy */}
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-neutral-900 mb-6">
        {t('financialPolicyPage.cancellationHeading')}
      </h2>
      <div class="space-y-4">
        <p class="text-lg text-neutral-700 leading-relaxed">
          {t('financialPolicyPage.cancellationP1')}
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed">
          {t('financialPolicyPage.cancellationP2')}
        </p>
      </div>
    </div>
  </section>

  {/* Questions Callout */}
  <section class="py-16 bg-primary-50">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-display text-2xl font-bold text-neutral-900 mb-4">
        {t('financialPolicyPage.questionsHeading')}
      </h2>
      <p class="text-neutral-700 mb-8">
        {t('financialPolicyPage.questionsDescription')}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="tel:+5058771113"
          class="inline-flex items-center bg-primary-500 text-white font-semibold rounded-lg px-6 py-3 hover:bg-primary-600 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          (505) 877-1113
        </a>
        <a
          href="mailto:emersonvicunadds@gmail.com"
          class="inline-flex items-center border-2 border-primary-500 text-primary-700 font-semibold rounded-lg px-6 py-3 hover:bg-primary-100 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
          Email Us
        </a>
      </div>
    </div>
  </section>

  {/* Final CTA */}
  <FinalCta locale="en" />
</BaseLayout>
