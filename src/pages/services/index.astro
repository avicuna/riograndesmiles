---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import BookingSection from '../../components/BookingSection.astro';
---

<BaseLayout
  title="Our Services | Rio Grande Smiles — Dentist in Albuquerque, NM"
  description="Comprehensive dental services including cleanings and checkups, fillings, crowns, implants, veneers, root canals, extractions, and more at Rio Grande Smiles in Albuquerque, NM."
  locale="en"
  canonicalPath="/services/"
>
  <section class="bg-bg-warm border-b border-line py-12 text-center">
    <div class="max-w-content mx-auto px-4">
      <h1 class="font-display text-3xl md:text-4xl font-medium text-ink">
        Our Services
      </h1>
      <p class="text-ink-2 mt-2 text-lg">Comprehensive dental care in Albuquerque, NM</p>
    </div>
  </section>

  <section class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <ServicesGrid locale="en" />
  </section>

  <BookingSection locale="en" />
</BaseLayout>
