---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BookingSection from '../../../components/BookingSection.astro';

const services = await getCollection('services');
const sorted = services.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Nuestros Servicios | Rio Grande Smiles — Dentista en Albuquerque, NM"
  description="Servicios dentales completos incluyendo extracciones, rellenos, implantes, coronas, carillas, tratamientos de conducto y más en Rio Grande Smiles en Albuquerque, NM."
  locale="es"
  canonicalPath="/es/services/"
>
  <section class="bg-primary-50 py-12 text-center">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="font-display text-3xl md:text-4xl font-bold text-neutral-900">
        Nuestros Servicios
      </h1>
      <p class="text-neutral-600 mt-2 text-lg">Atención dental integral en Albuquerque, NM</p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sorted.map((service) => (
        <a
          href={`/es/services/${service.data.serviceSlug}`}
          class="group bg-white border border-neutral-200 rounded-xl p-8 text-center motion-safe:hover:-translate-y-1 hover:shadow-lg transition-all duration-200"
        >
          <div class="inline-flex items-center justify-center w-14 h-14 bg-primary-50 rounded-xl mb-4 text-2xl">
            {service.data.icon}
          </div>
          <h2 class="font-display text-lg font-semibold text-neutral-900 mb-2">
            {service.data.titleEs}
          </h2>
          <p class="text-sm text-neutral-600 mb-4">
            {service.data.descriptionEs}
          </p>
          <span class="text-sm font-medium text-primary-500 group-hover:text-primary-600 transition-colors">
            Ver más &rarr;
          </span>
        </a>
      ))}
    </div>
  </section>

  <BookingSection locale="es" />
</BaseLayout>
