---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServicesGrid from '../../../components/ServicesGrid.astro';
import BookingSection from '../../../components/BookingSection.astro';
---

<BaseLayout
  title="Nuestros Servicios | Rio Grande Smiles — Dentista en Albuquerque, NM"
  description="Servicios dentales completos, incluyendo limpiezas y chequeos, rellenos, coronas, implantes, carillas, tratamientos de conducto, extracciones y más en Rio Grande Smiles en Albuquerque, NM."
  locale="es"
  canonicalPath="/es/services/"
>
  <section class="bg-bg-warm border-b border-line py-12 text-center">
    <div class="max-w-content mx-auto px-4">
      <h1 class="font-display text-3xl md:text-4xl font-medium text-ink">
        Nuestros Servicios
      </h1>
      <p class="text-ink-2 mt-2 text-lg">Atención dental integral en Albuquerque, NM</p>
    </div>
  </section>

  <section class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <ServicesGrid locale="es" />
  </section>

  <BookingSection locale="es" />
</BaseLayout>
