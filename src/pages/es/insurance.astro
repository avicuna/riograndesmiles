---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import InsuranceGrid from '../../components/InsuranceGrid.astro';
import BookingSection from '../../components/BookingSection.astro';

const t = useTranslations('es');
---

<BaseLayout
  title="Seguros y Planes | Rio Grande Smiles"
  description="Aceptamos una variedad de planes de seguros incluyendo Medicaid, United Healthcare, Delta Dental, y más. Aprenda cómo funciona el seguro dental y qué traer a su cita."
  locale="es"
  canonicalPath="/es/insurance"
>
  {/* Hero Section */}
  <section class="bg-bg-warm border-b border-line py-12">
    <div class="max-w-content mx-auto px-6 text-center">
      <h1 class="font-display text-3xl md:text-4xl font-medium text-ink mb-4">
        {t('insurancePage.title')}
      </h1>
    </div>
  </section>

  {/* How Dental Insurance Works */}
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-ink text-center mb-6">
        {t('insurancePage.howItWorksHeading')}
      </h2>
      <p class="text-lg text-ink-2 text-center mb-12">
        {t('insurancePage.howItWorksIntro')}
      </p>

      {/* Info Cards */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        {/* Deductible Card */}
        <div class="bg-bg-card border border-line rounded-lg p-6">
          <h3 class="font-medium text-lg text-ink mb-3">
            {t('insurancePage.deductible.title')}
          </h3>
          <p class="text-ink-2 text-sm">
            {t('insurancePage.deductible.description')}
          </p>
        </div>

        {/* Co-Pay Card */}
        <div class="bg-bg-card border border-line rounded-lg p-6">
          <h3 class="font-medium text-lg text-ink mb-3">
            {t('insurancePage.copay.title')}
          </h3>
          <p class="text-ink-2 text-sm">
            {t('insurancePage.copay.description')}
          </p>
        </div>

        {/* Coverage Card */}
        <div class="bg-bg-card border border-line rounded-lg p-6">
          <h3 class="font-medium text-lg text-ink mb-3">
            {t('insurancePage.coverage.title')}
          </h3>
          <p class="text-ink-2 text-sm">
            {t('insurancePage.coverage.description')}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Insurance Grid */}
  <InsuranceGrid locale="es" />

  {/* Not Sure About Coverage */}
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6">
      <div class="bg-bg-warm rounded-lg p-8 text-center">
        <h2 class="font-display text-2xl font-medium text-ink mb-4">
          {t('insurancePage.notSureHeading')}
        </h2>
        <p class="text-ink-2 mb-6">
          {t('insurancePage.notSureDescription')}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="tel:+15058771113"
            class="btn btn-primary"
          >
            <Icon name="phone" class="w-[18px] h-[18px]" />
            (505) 877-1113
          </a>
          <a
            href="mailto:emersonvicunadds@gmail.com"
            class="btn btn-line"
          >
            <Icon name="mail" class="w-[18px] h-[18px]" />
            Enviar Email
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* What to Bring */}
  <section class="py-16 bg-bg-warm">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-ink text-center mb-8">
        {t('insurancePage.whatToBringHeading')}
      </h2>
      <div class="space-y-4">
        {t.list('insurancePage.whatToBringItems').map((item) => (
          <div class="flex items-start gap-4 bg-bg-card border border-line rounded-lg p-4">
            <Icon name="check" class="w-4 h-4 text-primary-500 flex-shrink-0 mt-1" strokeWidth={2.6} />
            <p class="text-ink-2 font-medium">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Forms Reminder */}
  <section class="py-12 bg-bg-warm">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h3 class="font-display text-xl font-medium text-ink mb-2">{t('insurancePage.formsReminder')}</h3>
      <p class="text-ink-2 mb-6">{t('insurancePage.formsReminderBody')}</p>
      <a
        href="/es/new-patients/#forms"
        class="btn btn-primary"
      >
        {t('formsCallout.cta')}
      </a>
    </div>
  </section>

  {/* Booking Section */}
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6">
      <BookingSection locale="es" />
    </div>
  </section>
</BaseLayout>
