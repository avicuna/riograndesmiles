---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import MapSection from '../../components/MapSection.astro';
import ContactForm from '../../components/ContactForm.astro';

const locale = 'es';
const t = useTranslations(locale);
---

<BaseLayout
  title={t('contact.title')}
  description={t('contact.pageDescription')}
  locale={locale}
  canonicalPath="/es/contact"
>
  {/* Hero Header */}
  <section class="bg-bg-warm border-b border-line py-16 md:py-20">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="uppercase tracking-wider text-primary-500 text-xs font-medium">
        {t('footer.contact')}
      </span>
      <h1 class="font-display text-3xl md:text-5xl font-medium text-ink mt-3">
        {t('contact.title')}
      </h1>
    </div>
  </section>

  {/* Map + Hours Section */}
  <MapSection locale={locale} />

  {/* Contact Form Section */}
  <section class="py-16 md:py-20 bg-bg-card">
    <div class="max-w-lg mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-ink mb-8 text-center">
        {t('contact.formHeading')}
      </h2>

      <ContactForm locale={locale} />
    </div>
  </section>

  {/* Directions Section */}
  <section class="py-12 bg-bg-warm">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="font-display text-xl font-medium text-ink mb-4 text-center">
        {t('contact.directionsHeading')}
      </h3>
      <p class="text-ink-2 text-center leading-relaxed">
        {t('contact.directionsText')}
      </p>
    </div>
  </section>
</BaseLayout>
