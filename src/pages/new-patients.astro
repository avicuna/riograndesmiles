---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import JourneySteps from '../components/JourneySteps.astro';
import FAQAccordion from '../components/FAQAccordion';
import BookingSection from '../components/BookingSection.astro';

const locale = 'en';
const t = useTranslations(locale);

// First Appointment FAQ items
const firstAppointmentFaq = [
  {
    question: t('faq.firstAppointment.arriveEarly'),
    answer: t('faq.firstAppointment.arriveEarlyAnswer'),
  },
  {
    question: t('faq.firstAppointment.preMedication'),
    answer: t('faq.firstAppointment.preMedicationAnswer'),
  },
  {
    question: t('faq.firstAppointment.bring'),
    answer: `${t('faq.firstAppointment.bringAnswer')}
• ${t('faq.firstAppointment.bringItem1')}
• ${t('faq.firstAppointment.bringItem2')}
• ${t('faq.firstAppointment.bringItem3')}
• ${t('faq.firstAppointment.bringItem4')}`,
  },
  {
    question: t('faq.firstAppointment.duration'),
    answer: t('faq.firstAppointment.durationAnswer'),
  },
];
---

<BaseLayout
  title={t('newPatients.title')}
  description={t('newPatients.pageDescription')}
  locale={locale}
  canonicalPath="/new-patients"
>
  {/* Hero Header */}
  <section class="bg-bg-warm border-b border-line py-16 md:py-20">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="uppercase tracking-wider text-primary-500 text-xs font-medium">
        {t('journey.label')}
      </span>
      <h1 class="font-display text-3xl md:text-5xl font-medium text-ink mt-3">
        {t('newPatients.title')}
      </h1>
    </div>
  </section>

  {/* Journey Steps */}
  <JourneySteps locale={locale} />

  {/* What to Bring Section */}
  <section class="py-16 md:py-20 bg-bg-warm">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-ink mb-8 text-center">
        {t('newPatients.whatToBringHeading')}
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {t.list('newPatients.whatToBringItems').map((item) => (
          <div class="flex items-start bg-bg-card p-5 rounded-lg border border-line">
            <Icon name="check" class="w-4 h-4 text-primary-500 mr-3 mt-1 flex-shrink-0" strokeWidth={2.6} />
            <span class="text-ink-2 font-medium">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Your First Visit Section */}
  <section class="py-16 md:py-20 bg-bg-card">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-ink mb-6 text-center">
        {t('newPatients.firstVisitHeading')}
      </h2>
      <div class="prose prose-lg max-w-none text-ink-2">
        <p class="leading-relaxed mb-4">
          {t('newPatients.firstVisitP1')}
        </p>
        <p class="leading-relaxed">
          {t('newPatients.firstVisitP2')}
        </p>
      </div>
    </div>
  </section>

  {/* Downloadable Forms Section */}
  <section id="forms" class="py-16 md:py-20 bg-bg-warm">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-ink mb-4 text-center">
        {t('newPatients.downloadFormsHeading')}
      </h2>
      <p class="text-center text-ink-2 mb-10 max-w-2xl mx-auto">
        {t('newPatients.downloadFormsIntro')}
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        {/* Medical History Form */}
        <div class="bg-bg-card p-6 rounded-lg border border-line">
          <div class="flex items-start mb-4">
            <div class="flex-shrink-0 w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mr-4">
              <Icon name="document" class="w-6 h-6 text-primary-500" />
            </div>
            <div class="flex-1">
              <h3 class="font-display text-lg font-medium text-ink mb-2">
                {t('newPatients.medicalHistoryFormTitle')}
              </h3>
              <p class="text-sm text-ink-2 mb-4">
                {t('newPatients.medicalHistoryFormDesc')}
              </p>
              <a
                href="/forms/medical-history.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
              >
                {t('button.downloadForm')}
              </a>
            </div>
          </div>
        </div>

        {/* Patient Registration Form */}
        <div class="bg-bg-card p-6 rounded-lg border border-line">
          <div class="flex items-start mb-4">
            <div class="flex-shrink-0 w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mr-4">
              <Icon name="document" class="w-6 h-6 text-primary-500" />
            </div>
            <div class="flex-1">
              <h3 class="font-display text-lg font-medium text-ink mb-2">
                {t('newPatients.patientRegistrationFormTitle')}
              </h3>
              <p class="text-sm text-ink-2 mb-4">
                {t('newPatients.patientRegistrationFormDesc')}
              </p>
              <a
                href="/forms/patient-registration.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
              >
                {t('button.downloadForm')}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* First Appointment FAQ */}
  <section class="py-16 md:py-20 bg-bg-card">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-ink mb-10 text-center">
        {t('newPatients.firstAppointmentFaqHeading')}
      </h2>
      <FAQAccordion items={firstAppointmentFaq} client:visible />
    </div>
  </section>

  {/* Booking CTA */}
  <section class="py-16 px-6 bg-bg-warm">
    <div class="max-w-4xl mx-auto">
      <BookingSection locale={locale} />
    </div>
  </section>
</BaseLayout>
