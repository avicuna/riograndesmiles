---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import BookingSection from '../components/BookingSection.astro';

const t = useTranslations('en');
---

<BaseLayout
  title="Affordable Dental Care | Rio Grande Smiles"
  description="We believe quality dental care should be accessible to everyone. Medicaid welcome, most insurance accepted, transparent pricing, and self-pay options available."
  locale="en"
  canonicalPath="/affordable-care"
>
  {/* Hero Section */}
  <section class="bg-bg-warm border-b border-line py-12">
    <div class="max-w-content mx-auto px-6 text-center">
      <h1 class="font-display text-3xl md:text-4xl font-medium text-ink mb-4">
        {t('affordableCarePage.title')}
      </h1>
    </div>
  </section>

  {/* Welcome Message */}
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-ink mb-6">
        {t('affordableCarePage.welcomeHeading')}
      </h2>
      <p class="text-lg text-ink-2 mb-8">
        {t('affordableCarePage.welcomeMessage')}
      </p>
      <div class="inline-flex items-center bg-primary-500 text-white font-medium px-6 py-3 rounded-full">
        <Icon name="check" class="w-4 h-4 mr-2" strokeWidth={2.6} />
        {t('affordableCarePage.medicaidBadge')}
      </div>
    </div>
  </section>

  {/* How We Keep Care Affordable */}
  <section class="py-16 bg-bg-warm">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-ink text-center mb-12">
        {t('affordableCarePage.howWeHelpHeading')}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {/* Insurance Card */}
        <div class="bg-bg-card border border-line rounded-lg p-8">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <Icon name="clipboard" class="w-6 h-6 text-primary-500" />
          </div>
          <h3 class="font-medium text-xl text-ink mb-3">
            {t('affordableCarePage.insurance.title')}
          </h3>
          <p class="text-ink-2">
            {t('affordableCarePage.insurance.description')}
          </p>
        </div>

        {/* Transparent Pricing Card */}
        <div class="bg-bg-card border border-line rounded-lg p-8">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <Icon name="banknote" class="w-6 h-6 text-primary-500" />
          </div>
          <h3 class="font-medium text-xl text-ink mb-3">
            {t('affordableCarePage.transparent.title')}
          </h3>
          <p class="text-ink-2">
            {t('affordableCarePage.transparent.description')}
          </p>
        </div>

        {/* Self-Pay Card */}
        <div class="bg-bg-card border border-line rounded-lg p-8">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <Icon name="wallet" class="w-6 h-6 text-primary-500" />
          </div>
          <h3 class="font-medium text-xl text-ink mb-3">
            {t('affordableCarePage.selfPay.title')}
          </h3>
          <p class="text-ink-2">
            {t('affordableCarePage.selfPay.description')}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Community Resources */}
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-ink text-center mb-6">
        {t('affordableCarePage.resourcesHeading')}
      </h2>
      <p class="text-lg text-ink-2 text-center mb-10">
        {t('affordableCarePage.resourcesIntro')}
      </p>

      <div class="space-y-6">
        {/* Resource 1 */}
        <div class="bg-bg-card border border-line rounded-lg p-6">
          <h3 class="font-medium text-lg text-ink mb-2">
            {t('affordableCarePage.resource1Title')}
          </h3>
          <p class="text-ink-2">
            {t('affordableCarePage.resource1Description')}
          </p>
        </div>

        {/* Resource 2 */}
        <div class="bg-bg-card border border-line rounded-lg p-6">
          <h3 class="font-medium text-lg text-ink mb-2">
            {t('affordableCarePage.resource2Title')}
          </h3>
          <p class="text-ink-2">
            {t('affordableCarePage.resource2Description')}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Booking Section */}
  <section class="py-16 bg-bg-warm">
    <div class="max-w-3xl mx-auto px-6">
      <BookingSection locale="en" />
    </div>
  </section>
</BaseLayout>
