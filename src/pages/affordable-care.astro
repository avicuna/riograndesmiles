---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import BookingSection from '../components/BookingSection.astro';

const t = useTranslations('en');
---

<BaseLayout
  title="Affordable Dental Care | Rio Grande Smiles"
  description="We believe quality dental care should be accessible to everyone. Medicaid welcome, most insurance accepted, transparent pricing, and self-pay options available."
  locale="en"
  canonicalPath="/affordable-care"
>
  {/* Hero Section */}
  <section class="bg-primary-50 py-12">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h1 class="font-display text-3xl md:text-4xl font-bold text-neutral-900 mb-4">
        {t('affordableCarePage.title')}
      </h1>
    </div>
  </section>

  {/* Welcome Message */}
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-neutral-900 mb-6">
        {t('affordableCarePage.welcomeHeading')}
      </h2>
      <p class="text-lg text-neutral-600 mb-8">
        {t('affordableCarePage.welcomeMessage')}
      </p>
      <div class="inline-flex items-center bg-primary-500 text-white font-semibold px-6 py-3 rounded-lg">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {t('affordableCarePage.medicaidBadge')}
      </div>
    </div>
  </section>

  {/* How We Keep Care Affordable */}
  <section class="py-16 bg-neutral-50">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-neutral-900 text-center mb-12">
        {t('affordableCarePage.howWeHelpHeading')}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {/* Insurance Card */}
        <div class="bg-white border border-neutral-200 rounded-xl p-8 shadow-sm">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
            </svg>
          </div>
          <h3 class="font-semibold text-xl text-neutral-900 mb-3">
            {t('affordableCarePage.insurance.title')}
          </h3>
          <p class="text-neutral-600">
            {t('affordableCarePage.insurance.description')}
          </p>
        </div>

        {/* Transparent Pricing Card */}
        <div class="bg-white border border-neutral-200 rounded-xl p-8 shadow-sm">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
            </svg>
          </div>
          <h3 class="font-semibold text-xl text-neutral-900 mb-3">
            {t('affordableCarePage.transparent.title')}
          </h3>
          <p class="text-neutral-600">
            {t('affordableCarePage.transparent.description')}
          </p>
        </div>

        {/* Self-Pay Card */}
        <div class="bg-white border border-neutral-200 rounded-xl p-8 shadow-sm">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 00-2.25-2.25H15a3 3 0 11-6 0H5.25A2.25 2.25 0 003 12m18 0v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 9m18 0V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v3" />
            </svg>
          </div>
          <h3 class="font-semibold text-xl text-neutral-900 mb-3">
            {t('affordableCarePage.selfPay.title')}
          </h3>
          <p class="text-neutral-600">
            {t('affordableCarePage.selfPay.description')}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Community Resources */}
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-neutral-900 text-center mb-6">
        {t('affordableCarePage.resourcesHeading')}
      </h2>
      <p class="text-lg text-neutral-600 text-center mb-10">
        {t('affordableCarePage.resourcesIntro')}
      </p>

      <div class="space-y-6">
        {/* Resource 1 */}
        <div class="bg-white border border-neutral-200 rounded-xl p-6 shadow-sm">
          <h3 class="font-semibold text-lg text-neutral-900 mb-2">
            {t('affordableCarePage.resource1Title')}
          </h3>
          <p class="text-neutral-600">
            {t('affordableCarePage.resource1Description')}
          </p>
        </div>

        {/* Resource 2 */}
        <div class="bg-white border border-neutral-200 rounded-xl p-6 shadow-sm">
          <h3 class="font-semibold text-lg text-neutral-900 mb-2">
            {t('affordableCarePage.resource2Title')}
          </h3>
          <p class="text-neutral-600">
            {t('affordableCarePage.resource2Description')}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Booking Section */}
  <section class="py-16 bg-neutral-50">
    <div class="max-w-3xl mx-auto px-6">
      <BookingSection locale="en" />
    </div>
  </section>
</BaseLayout>
