  <TrustBar locale="en" />
  <InsuranceGrid locale="en" />
  <ServicesOverview locale="en" />
  <DoctorProfile locale="en" />
  <!-- Reviews section placeholder -->
  <JourneySteps locale="en" />
  <AffordableCareCallout locale="en" />
  <!-- Map + Hours section placeholder -->
  <FinalCta locale="en" />
</BaseLayout>
