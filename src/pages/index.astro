---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import InsuranceGrid from '../components/InsuranceGrid.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import DoctorProfile from '../components/DoctorProfile.astro';
import JourneySteps from '../components/JourneySteps.astro';
import AffordableCareCallout from '../components/AffordableCareCallout.astro';
import FinalCta from '../components/FinalCta.astro';
