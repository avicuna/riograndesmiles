---
// Homepage hero, plus the quick-action bar (Call, Text, Directions, Insurance) that overlaps its
// bottom edge. The bar's negative bottom margin tucks it into the top of the doctor band below,
// which leaves room for it with extra top padding (DoctorProfile.astro).
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { PHONE_TEL, PHONE_SMS, DIRECTIONS_URL } from '../lib/contact';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === 'es' ? '/es' : '';

const checks = [t('hero.chipExperience'), t('hero.chipFamily'), t('hero.chipInsurance')];

const actions = [
  { href: PHONE_TEL, icon: 'phone', small: t('quickActions.callSmall'), big: t('footer.phone'), primary: true },
  { href: PHONE_SMS, icon: 'chat', small: t('quickActions.textSmall'), big: t('quickActions.textBig') },
  { href: DIRECTIONS_URL, icon: 'pin', small: t('quickActions.directionsSmall'), big: t('quickActions.directionsBig') },
  { href: `${prefix}/insurance/`, icon: 'shield', small: t('quickActions.insuranceSmall'), big: t('quickActions.insuranceBig') },
] as const;
---

<section class="relative overflow-hidden bg-bg" aria-labelledby="hero-title">
  {/* Albuquerque skyline along the bottom edge, fading into the page at the top */}
  <div class="hero-sky absolute inset-x-0 bottom-0 h-[200px] md:h-[260px]" role="img" aria-label={t('hero.skylineAlt')}></div>

  <div class="relative max-w-content mx-auto px-5 sm:px-7 grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-2 lg:gap-10 items-end pt-9 lg:pt-14">
    <div class="lg:pb-44">
      <p class="inline-flex items-center gap-2.5 bg-white border border-line rounded-full py-1.5 pl-1.5 pr-4 text-[0.875rem] font-medium text-ink mb-5">
        <span class="grid place-items-center w-[30px] h-[30px] rounded-full bg-primary-500 text-white">
          <Icon name="check" class="w-4 h-4" strokeWidth={2.6} />
        </span>
        {t('hero.pill')}
      </p>

      <h1 id="hero-title" class="font-semibold text-[2.6rem] sm:text-[3.4rem] lg:text-[4.1rem] leading-[1.04]">
        {t('hero.title1')}<span class="text-primary-500">{t('hero.titleEm')}</span>{t('hero.title2')}
      </h1>

      <p class="mt-5 text-[1.06rem] sm:text-[1.125rem] text-ink-2 leading-relaxed max-w-[540px]">
        {t('hero.lede')}
      </p>

      <ul class="mt-5 grid gap-2.5" role="list">
        {checks.map((item) => (
          <li class="flex items-center gap-3 font-medium text-ink">
            <span class="grid place-items-center shrink-0 w-6 h-6 rounded-full bg-accent-700 text-white">
              <Icon name="check" class="w-3.5 h-3.5" strokeWidth={2.6} />
            </span>
            {item}
          </li>
        ))}
      </ul>

      <div class="mt-7 flex flex-wrap gap-3">
        <a href={PHONE_TEL} class="btn btn-primary flex-auto sm:flex-none">
          <Icon name="phone" class="w-[18px] h-[18px]" />
          {t('hero.callButton')}
        </a>
        <a href={PHONE_SMS} class="btn btn-line flex-auto sm:flex-none">
          <Icon name="chat" class="w-[18px] h-[18px]" />
          {t('hero.textButton')}
        </a>
      </div>
      <p class="mt-3.5 flex flex-wrap gap-x-6">
        <a href={`${prefix}/services/`} class="inline-flex items-center min-h-[44px] font-semibold text-primary-700 no-underline hover:underline">
          {t('hero.servicesLink')} →
        </a>
        <a href={`${prefix}/new-patients/#forms`} class="inline-flex items-center min-h-[44px] font-semibold text-primary-700 no-underline hover:underline">
          {t('hero.formsLink')} →
        </a>
      </p>
    </div>

    {/* Portrait in an arch, over a blue shape */}
    <div class="relative h-[420px] lg:h-[560px] flex justify-center items-end">
      <div class="hero-blob absolute left-1/2 -translate-x-1/2 bottom-10 lg:bottom-[70px] w-[320px] h-[320px] lg:w-[440px] lg:h-[440px] bg-primary-500" aria-hidden="true"></div>
      <div class="hidden lg:block absolute top-9 right-6 w-[120px] h-[120px] rounded-full border-2 border-dashed border-accent-400" aria-hidden="true"></div>
      <div class="relative w-[290px] h-[380px] lg:w-[400px] lg:h-[510px] rounded-t-full overflow-hidden border-8 border-b-0 border-white bg-primary-100">
        <img
          src="/img/doctor-headshot.jpg"
          alt={t('hero.photoAlt')}
          width="1100"
          height="766"
          class="w-full h-full object-cover object-[50%_25%]"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <p class="absolute right-1 lg:right-0 bottom-[110px] lg:bottom-[170px] bg-white rounded-2xl px-[18px] py-3.5 shadow-[0_14px_34px_rgba(15,48,84,0.16)] text-[0.875rem] leading-snug text-ink-2">
        <b class="block text-[0.97rem] text-ink">{t('hero.doctorName')}</b>
        {t('hero.doctorSince')}
      </p>
    </div>
  </div>
</section>

{/* Quick actions, overlapping the bottom of the hero */}
<div class="relative z-10 max-w-content mx-auto px-5 sm:px-7 -mt-10 lg:-mt-20 -mb-10 lg:-mb-[72px]">
  <nav aria-label={t('quickActions.label')} class="grid grid-cols-2 lg:grid-cols-4 bg-white rounded-[20px] shadow-[0_20px_50px_rgba(15,48,84,0.14)] overflow-hidden">
    {actions.map((action, i) => (
      <a
        href={action.href}
        class:list={[
          'flex flex-col lg:flex-row items-start lg:items-center gap-2.5 lg:gap-3.5 p-[18px] lg:px-[26px] lg:py-6 min-h-[88px] lg:min-h-[100px] no-underline transition-colors',
          'border-bg-warm',
          i % 2 === 0 && 'border-r',
          i === 1 && 'lg:border-r',
          i < 2 && 'border-b lg:border-b-0',
          'primary' in action ? 'bg-primary-500 text-white hover:bg-primary-700' : 'text-ink hover:bg-primary-50',
        ]}
      >
        <span class:list={[
          'grid place-items-center shrink-0 w-12 h-12 rounded-xl',
          'primary' in action ? 'bg-white/15 text-white' : 'bg-primary-50 text-primary-500',
        ]}>
          <Icon name={action.icon} class="w-[22px] h-[22px]" />
        </span>
        <span>
          <small class:list={['block text-[0.8rem] leading-snug', 'primary' in action ? 'text-white' : 'text-ink-3']}>{action.small}</small>
          <b class="block text-[1rem] lg:text-[1.06rem] font-semibold">{action.big}</b>
        </span>
      </a>
    ))}
  </nav>
</div>

<style>
  /* The photo fades in from the top, so there's no hard edge where it starts. */
  .hero-sky {
    background: url('/img/albuquerque-skyline.jpg') center 60% / cover no-repeat;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgb(0 0 0 / 0.1) 30%, rgb(0 0 0 / 0.75) 70%, #000 100%);
    mask-image: linear-gradient(180deg, transparent 0%, rgb(0 0 0 / 0.1) 30%, rgb(0 0 0 / 0.75) 70%, #000 100%);
  }
  .hero-blob {
    border-radius: 46% 54% 42% 58% / 52% 44% 56% 48%;
  }
</style>
