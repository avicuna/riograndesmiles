---
import type { Locale } from '../i18n/utils';
import { useTranslations, getAlternatePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const alternatePath = getAlternatePath(Astro.url.pathname, locale);

const prefix = locale === 'es' ? '/es' : '';
const serviceLinks = [
  { label: t('footer.generalDentistry'), href: `${prefix}/services/extractions/` },
  { label: t('footer.cosmetic'), href: `${prefix}/services/bleaching/` },
  { label: t('footer.implants'), href: `${prefix}/services/implants/` },
  { label: t('footer.rootCanals'), href: `${prefix}/services/root-canals/` },
  { label: t('footer.crownsBridges'), href: `${prefix}/services/crowns/` },
  { label: t('footer.allServices'), href: `${prefix}/services/` },
];

const patientLinks = [
  { label: t('footer.newPatient'), href: `${prefix}/new-patients/` },
  { label: t('footer.insurancePlans'), href: `${prefix}/insurance/` },
  { label: t('footer.affordableCare'), href: `${prefix}/affordable-care/` },
  { label: t('footer.forms'), href: `${prefix}/new-patients/` },
  { label: t('footer.faq'), href: `${prefix}/faq/` },
];
---

<footer class="bg-neutral-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      {/* Column 1: Brand */}
      <div>
        <span class="font-display text-xl font-bold text-white">
          {t('footer.brand')}
        </span>
        <p class="mt-3 text-sm text-white/60 leading-relaxed">
          {t('footer.brandDescription')}
        </p>
      </div>

      {/* Column 2: Services */}
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-white mb-4">
          {t('footer.servicesHeading')}
        </h3>
        <ul class="space-y-2.5">
          {serviceLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/60 hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Column 3: Patients */}
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-white mb-4">
          {t('footer.patientsHeading')}
        </h3>
        <ul class="space-y-2.5">
          {patientLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/60 hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Column 4: Contact */}
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-white mb-4">
          {t('footer.contact')}
        </h3>
        <ul class="space-y-2.5">
          <li>
            <a
              href="tel:+5058771113"
              class="flex items-center text-sm text-white/60 hover:text-white transition-colors"
            >
              <svg class="w-4 h-4 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              {t('footer.phone')}
            </a>
          </li>
          <li>
            <a
              href="mailto:emersonvicunadds@gmail.com"
              class="flex items-center text-sm text-white/60 hover:text-white transition-colors"
            >
              <svg class="w-4 h-4 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              {t('footer.email')}
            </a>
          </li>
          <li class="flex items-start text-sm text-white/60">
            <svg class="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span>
              {t('footer.addressLine1')}<br />
              {t('footer.addressLine2')}
            </span>
          </li>
          <li class="flex items-center text-sm text-white/60">
            <svg class="w-4 h-4 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {t('footer.hours.description')}
          </li>
        </ul>
      </div>
    </div>
  </div>

  {/* Bottom bar */}
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-white/40">
        &copy; {t('footer.copyright')}
      </p>
      <a
        href={alternatePath}
        class="text-sm text-white/40 hover:text-white transition-colors"
      >
        {t('footer.langSwitch')}
      </a>
    </div>
  </div>
</footer>
