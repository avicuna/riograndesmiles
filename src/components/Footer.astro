---
import type { Locale } from '../i18n/utils';
import { useTranslations, getAlternatePath } from '../i18n/utils';
import { PHONE_TEL, EMAIL, DIRECTIONS_URL } from '../lib/contact';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);

// Evaluated at build time, so the year rolls over on the first deploy of each new year.
const year = new Date().getFullYear();

const prefix = locale === 'es' ? '/es' : '';
const homePath = locale === 'es' ? '/es/' : '/';
const currentPath = Astro.url.pathname;
// A 404 has no translated twin at the same address, so its link goes to the other homepage.
const isNotFound = /^\/(es\/)?404(\/|\.html)?$/.test(currentPath);
const alternatePath = isNotFound ? (locale === 'es' ? '/' : '/es/') : getAlternatePath(currentPath, locale);
const alternateLang = locale === 'es' ? 'en' : 'es';

const columns = [
  {
    heading: t('footer.navigate'),
    links: [
      { label: t('navbar.about'), href: `${prefix}/about/` },
      { label: t('navbar.services'), href: `${prefix}/services/` },
      { label: t('navbar.insurance'), href: `${prefix}/insurance/` },
      { label: t('navbar.reviews'), href: `${prefix}/reviews/` },
      { label: t('navbar.contact'), href: `${prefix}/contact/` },
    ],
  },
  {
    heading: t('footer.patientsHeading'),
    links: [
      { label: t('navbar.newPatients'), href: `${prefix}/new-patients/` },
      { label: locale === 'es' ? 'Atención Accesible' : 'Affordable Care', href: `${prefix}/affordable-care/` },
      { label: locale === 'es' ? 'Política Financiera' : 'Financial Policy', href: `${prefix}/financial-policy/` },
      { label: t('footer.faq'), href: `${prefix}/faq/` },
      { label: t('footer.medHistory'), href: `${prefix}/new-patients/#forms` },
    ],
  },
];
const link = 'inline-flex items-center min-h-[40px] text-primary-100 no-underline hover:text-white hover:underline';
---

<footer class="bg-primary-900 text-primary-200 text-[0.94rem] pt-[72px]">
  <div class="max-w-content mx-auto px-5 sm:px-7 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr] gap-10">
    <div>
      <a href={homePath} class="inline-flex items-center gap-3 no-underline text-white">
        {/* The faint ring keeps the blue tile's edge visible on the navy footer. */}
        <img src="/brand-tile.svg" alt="" width="42" height="42" class="shrink-0 w-[42px] h-[42px] rounded-xl ring-[1.5px] ring-white/20" />
        <span>
          <span class="block font-display text-[1.375rem] font-semibold leading-[1.05]">{t('footer.brand')}</span>
          <span class="block text-[0.78rem] text-primary-200">{t('footer.brandSub')}</span>
        </span>
      </a>
      <p class="mt-4 max-w-[300px] leading-relaxed">{t('footer.tagline')}</p>
    </div>

    {columns.map((column) => (
      <nav aria-label={column.heading}>
        <h2 class="mb-3 font-sans !text-white text-[0.8rem] font-bold uppercase tracking-[0.14em]">{column.heading}</h2>
        <ul role="list">
          {column.links.map((item) => (
            <li><a href={item.href} class={link}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}

    <div>
      <h2 class="mb-3 font-sans !text-white text-[0.8rem] font-bold uppercase tracking-[0.14em]">{t('footer.contact')}</h2>
      <ul role="list">
        <li><a href={PHONE_TEL} class={link}>{t('footer.phone')}</a></li>
        <li><a href={`mailto:${EMAIL}`} class={link}>{EMAIL}</a></li>
        <li>
          <a href={DIRECTIONS_URL} class="inline-block py-1.5 leading-relaxed text-primary-100 no-underline hover:text-white hover:underline">
            {t('footer.addressLine1')}<br />{t('footer.addressLine2')}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="max-w-content mx-auto px-5 sm:px-7 mt-14">
    <div class="flex flex-col sm:flex-row sm:justify-between gap-2 py-5 border-t border-white/15 text-[0.875rem]">
      <span>&copy; {year} {t('footer.copyright')}</span>
      <a href={alternatePath} lang={alternateLang} hreflang={alternateLang} class="text-primary-100 underline hover:text-white">
        {t('navbar.switchLangAria')}
      </a>
    </div>
  </div>
</footer>
