---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Messages are delivered by Web3Forms (https://web3forms.com) to the office inbox,
// emersonvicunadds@gmail.com, which owns the Web3Forms account. The access key is public by
// design: it only lets someone send a message to that inbox. See "Contact Form" in the README.
const accessKey = '7466b363-7a5c-46d4-89fa-7c3e5f9b2f35';
const subject = `New message from riograndesmiles.com${locale === 'es' ? ' (Spanish page)' : ''}`;

const fieldClass =
  'w-full px-4 py-3 border border-line rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors';
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="space-y-6"
  data-contact-form
  data-sending={t('contact.sending')}
  data-success={t('contact.success')}
  data-error={t('contact.error')}
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={subject} />
  <input type="hidden" name="from_name" value="Rio Grande Smiles website" />
  {/* Spam trap: hidden from people, so only bots tick it, and Web3Forms drops those messages. */}
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

  <div>
    <label for="name" class="block text-sm font-medium text-ink mb-2">
      {t('contact.nameLabel')} <span class="text-red-500">*</span>
    </label>
    <input type="text" id="name" name="name" autocomplete="name" required aria-required="true" class={fieldClass} />
  </div>

  <div>
    <label for="phone" class="block text-sm font-medium text-ink mb-2">
      {t('contact.phoneLabel')}
    </label>
    <input type="tel" id="phone" name="phone" autocomplete="tel" class={fieldClass} />
  </div>

  <div>
    <label for="email" class="block text-sm font-medium text-ink mb-2">
      {t('contact.emailLabel')} <span class="text-red-500">*</span>
    </label>
    <input type="email" id="email" name="email" autocomplete="email" required aria-required="true" class={fieldClass} />
  </div>

  <div>
    <label for="message" class="block text-sm font-medium text-ink mb-2">
      {t('contact.messageLabel')} <span class="text-red-500">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      aria-required="true"
      aria-describedby="message-note"
      class={`${fieldClass} resize-none`}
    ></textarea>
    <p id="message-note" class="mt-2 text-sm text-ink-3">{t('contact.privacyNote')}</p>
  </div>

  <button
    type="submit"
    class="w-full px-8 py-4 bg-primary-500 text-white font-medium rounded-full hover:bg-primary-700 transition-colors disabled:opacity-60 disabled:cursor-wait"
  >
    {t('contact.submitButton')}
  </button>

  <p data-form-status role="status" aria-live="polite" class="text-center font-medium empty:hidden"></p>
</form>

<script>
  // Send in the background and show the result on the page. Without JavaScript the form still
  // posts to Web3Forms directly and shows their confirmation page instead.
  document.querySelectorAll<HTMLFormElement>('form[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    const show = (text: string, ok: boolean) => {
      status.textContent = text;
      status.classList.toggle('text-primary-700', ok);
      status.classList.toggle('text-red-700', !ok);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      show(form.dataset.sending ?? '', true);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await response.json().catch(() => ({ success: false }));
        if (!response.ok || !result.success) throw new Error(result.message ?? `HTTP ${response.status}`);
        form.reset();
        show(form.dataset.success ?? '', true);
      } catch (error) {
        console.error('[contact form]', error);
        show(form.dataset.error ?? '', false);
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
