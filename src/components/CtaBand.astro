---
// "Call or text us today" band over the Albuquerque skyline, with a navy overlay for contrast.
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { PHONE_TEL, PHONE_SMS, EMAIL } from '../lib/contact';
import Icon from './Icon.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
---

<section class="cta-band relative overflow-hidden text-white" aria-labelledby="cta-title">
  <div class="cta-bg absolute inset-0" aria-hidden="true"></div>
  <div class="relative max-w-content mx-auto px-5 sm:px-7 py-16 lg:py-[88px] flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8 lg:gap-10">
    <div>
      <h2 id="cta-title" class="!text-white font-semibold text-[2.5rem] lg:text-[3.25rem] leading-[1.05]">{t('ctaBand.heading')}</h2>
      <p class="mt-3.5 text-[1.06rem] text-primary-100">{t('ctaBand.sub')}</p>
    </div>
    <div class="flex flex-wrap gap-3 shrink-0">
      <a href={PHONE_TEL} class="btn btn-white">
        <Icon name="phone" class="w-[18px] h-[18px]" />
        {t('ctaBand.callButton')}
      </a>
      <a href={PHONE_SMS} class="btn btn-glass">
        <Icon name="chat" class="w-[18px] h-[18px]" />
        {t('ctaBand.textButton')}
      </a>
      <a href={`mailto:${EMAIL}`} class="btn btn-glass">
        <Icon name="mail" class="w-[18px] h-[18px]" />
        {t('ctaBand.emailButton')}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-bg {
    background: url('/img/albuquerque-skyline.jpg') center 55% / cover no-repeat;
  }
  .cta-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    /* primary-900, dark enough behind the white text and outline buttons */
    background: linear-gradient(90deg, rgb(15 48 84 / 0.95) 0%, rgb(15 48 84 / 0.88) 55%, rgb(15 48 84 / 0.8) 100%);
  }
</style>
