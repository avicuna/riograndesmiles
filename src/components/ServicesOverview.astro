---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import SectionTag from './SectionTag.astro';
import { getServices, servicePath } from '../lib/services';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);

const services = await getServices();
---

<section class="bg-bg-warm py-[100px]">
  <div class="max-w-content mx-auto px-7">
    {/* Section header */}
    <div class="grid grid-cols-1 md:grid-cols-[1fr_1.3fr] gap-16 mb-14 items-end">
      <div>
        <SectionTag label={t('sectionTags.services')} />
        <h2 class="font-display text-[2.2rem] leading-[1.15] font-medium text-ink">
          {t('servicesOverview.heading')}
        </h2>
      </div>
      <p class="text-ink-3 max-w-[56ch] text-[1.05rem]">
        {t('servicesOverview.sub')}
      </p>
    </div>

    {/* Services grid — bg-line acts as the 1px gap color. The first service (Cleanings & Checkups)
        spans the full row, leaving 12 cards that fill 2- and 3-column rows evenly. */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 bg-line gap-px border border-line rounded-lg overflow-hidden">
      {services.map((service, i) => {
        const text = service.data[locale];
        const lead = i === 0;
        return (
          <a
            href={servicePath(service, locale)}
            class:list={[
              'group bg-bg-card p-8 flex gap-3 transition-colors hover:bg-primary-50 cursor-pointer no-underline',
              lead ? 'md:col-span-2 lg:col-span-3 flex-col md:flex-row md:items-center md:gap-10' : 'flex-col min-h-[220px]',
            ]}
          >
            {/* Title with number */}
            <h3 class:list={['font-display font-medium text-ink', lead ? 'text-[1.75rem] md:w-[22rem] md:shrink-0' : 'text-[1.4rem]']}>
              <span class="font-mono text-[0.72rem] text-primary-500 tracking-wide mr-2">{String(i + 1).padStart(2, '0')}</span>
              {text.title}
            </h3>

            {/* Description */}
            <p class:list={['text-ink-3 leading-relaxed', lead ? 'text-[1rem] md:flex-1' : 'text-[0.93rem]']}>
              {text.summary}
            </p>

            {/* Arrow button — always visible */}
            <div class:list={['w-8 h-8 rounded-full bg-bg-warm grid place-items-center text-ink-2 group-hover:bg-primary-500 group-hover:text-white group-hover:translate-x-[3px] group-hover:-translate-y-[3px] transition-all', lead ? 'mt-auto md:mt-0 shrink-0' : 'mt-auto']}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
