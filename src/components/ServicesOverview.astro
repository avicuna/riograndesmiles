---
// Homepage services: the services marked `homepage: true` in src/content/services/. The first one
// gets a wide card; the rest are tiles. A button links to the full list.
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { getServices, servicePath } from '../lib/services';
import type { ServiceIconName } from '../lib/service-icons';
import SectionTag from './SectionTag.astro';
import ServiceIcon from './ServiceIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === 'es' ? '/es' : '';

const services = await getServices();
const featured = services.filter((service) => service.data.homepage);
if (featured.length === 0) {
  throw new Error('[services] Mark at least one service with "homepage: true" to show it on the homepage.');
}
const [lead, ...tiles] = featured;
const leadText = lead.data[locale];
---

<section id="services" class="bg-bg py-20 lg:py-28" aria-labelledby="services-title">
  <div class="max-w-content mx-auto px-5 sm:px-7">
    <div class="mb-11 max-w-[640px]">
      <SectionTag label={t('sectionTags.services')} />
      <h2 id="services-title" class="font-semibold text-[2.375rem] lg:text-[2.875rem] leading-[1.1]">
        {t('servicesOverview.heading')}
      </h2>
      <p class="mt-4 text-[1.06rem] text-ink-2 max-w-[560px]">{t('servicesOverview.sub')}</p>
    </div>

    {/* Wide card for the first service */}
    <a
      href={servicePath(lead, locale)}
      class="group grid grid-cols-1 sm:grid-cols-[auto_1fr] lg:grid-cols-[auto_1fr_auto] gap-4 sm:gap-7 items-center mb-3 sm:mb-5 p-6 sm:px-8 sm:py-7 bg-white border border-bg-warm rounded-3xl no-underline text-ink transition-[border-color,box-shadow] hover:border-primary-300 hover:shadow-[0_12px_30px_rgba(15,48,84,0.08)]"
    >
      <span class="grid place-items-center w-[72px] h-[72px] rounded-[20px] bg-primary-500 text-white">
        <ServiceIcon name={lead.data.icon as ServiceIconName} class="w-[34px] h-[34px]" />
      </span>
      <div>
        <h3 class="font-semibold text-[1.75rem]">{leadText.title}</h3>
        <p class="mt-1 text-[1.03rem] text-ink-2">{leadText.summary}</p>
      </div>
      <span class="hidden lg:inline font-semibold text-primary-700 whitespace-nowrap">{t('servicesOverview.learnMore')} →</span>
    </a>

    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-5">
      {tiles.map((service, i) => {
        const text = service.data[locale];
        const teal = i % 2 === 1;
        return (
          <a
            href={servicePath(service, locale)}
            class:list={[
              'flex flex-col p-[18px] sm:p-[26px] rounded-[22px] border no-underline text-ink transition-[border-color,box-shadow,transform]',
              'hover:border-primary-300 hover:shadow-[0_12px_30px_rgba(15,48,84,0.08)] hover:-translate-y-0.5 motion-reduce:hover:translate-y-0',
              teal ? 'bg-accent-50 border-accent-100' : 'bg-primary-50 border-primary-100',
            ]}
          >
            <span class="grid place-items-center w-11 h-11 sm:w-[52px] sm:h-[52px] mb-3.5 sm:mb-5 rounded-2xl bg-white text-primary-500">
              <ServiceIcon name={service.data.icon as ServiceIconName} class="w-6 h-6 sm:w-[26px] sm:h-[26px]" />
            </span>
            <h3 class="font-semibold text-[1.125rem] sm:text-[1.375rem] sm:mb-1.5">{text.title}</h3>
            <p class="hidden sm:block flex-1 mb-[18px] text-[0.94rem] text-ink-2 leading-normal">{text.summary}</p>
            <span class="hidden sm:inline text-[0.9rem] font-semibold text-primary-700">
              {t('servicesOverview.learnMore')} →
            </span>
          </a>
        );
      })}
    </div>

    <p class="mt-9 text-center">
      <a href={`${prefix}/services/`} class="btn btn-line">
        {t('servicesOverview.seeAll').replace('{count}', String(services.length))} →
      </a>
    </p>
  </div>
</section>
