---
// Map and contact details in one card. Used on the homepage and the Contact page.
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { PHONE_TEL, EMAIL } from '../lib/contact';
import SectionTag from './SectionTag.astro';
import GoogleMap from './GoogleMap.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const label = 'mb-1.5 text-[0.78rem] font-bold uppercase tracking-[0.14em] text-ink-3';
---

<section id="location" class="py-20 lg:py-28" aria-labelledby="location-title">
  <div class="max-w-content mx-auto px-5 sm:px-7">
    <div class="mb-11">
      <SectionTag label={t('sectionTags.location')} />
      <h2 id="location-title" class="font-semibold text-[2.375rem] lg:text-[2.875rem] leading-[1.1] max-w-[640px]">{t('location.heading')}</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.25fr_0.75fr] bg-white border border-bg-warm rounded-3xl overflow-hidden">
      <div class="min-h-[300px] lg:min-h-[460px]">
        <GoogleMap locale={locale} />
      </div>
      <div class="grid gap-[22px] content-start p-7 sm:p-9">
        <div>
          <p class={label}>{t('location.addressLabel')}</p>
          <p class="text-[1.03rem] text-ink">{t('footer.addressLine1')}<br />{t('footer.addressLine2')}</p>
        </div>
        <div>
          <p class={label}>{t('location.phoneLabel')}</p>
          <a href={PHONE_TEL} class="inline-flex items-center min-h-[44px] text-[1.03rem] font-semibold text-primary-700">{t('footer.phone')}</a>
        </div>
        <div>
          <p class={label}>{t('location.emailLabel')}</p>
          <a href={`mailto:${EMAIL}`} class="inline-flex items-center min-h-[44px] text-[1.03rem] font-semibold text-primary-700 break-all">{EMAIL}</a>
        </div>
        <div>
          <p class={label}>{t('location.hoursLabel')}</p>
          <table class="w-full text-[0.94rem]">
            <tbody>
              <tr class="border-b border-dashed border-bg-warm">
                <th scope="row" class="py-1.5 text-left font-normal text-ink-2">{t('location.weekdays')}</th>
                <td class="py-1.5 text-right text-ink-2">{t('location.weekdaysHours')}</td>
              </tr>
              <tr>
                <th scope="row" class="py-1.5 text-left font-normal text-ink-3">{t('location.weekend')}</th>
                <td class="py-1.5 text-right text-ink-3">{t('location.closed')}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
