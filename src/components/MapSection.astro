---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import SectionTag from './SectionTag.astro';
import GoogleMap from './GoogleMap';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const days = locale === 'es'
  ? [
      { day: 'Lunes', time: '9:00 – 17:00' },
      { day: 'Martes', time: '9:00 – 17:00' },
      { day: 'Miércoles', time: '9:00 – 17:00' },
      { day: 'Jueves', time: '9:00 – 17:00' },
      { day: 'Viernes', time: 'Cerrado', closed: true },
      { day: 'Sábado – Domingo', time: 'Cerrado', closed: true },
    ]
  : [
      { day: 'Monday', time: '9:00 AM – 5:00 PM' },
      { day: 'Tuesday', time: '9:00 AM – 5:00 PM' },
      { day: 'Wednesday', time: '9:00 AM – 5:00 PM' },
      { day: 'Thursday', time: '9:00 AM – 5:00 PM' },
      { day: 'Friday', time: 'Closed', closed: true },
      { day: 'Saturday – Sunday', time: 'Closed', closed: true },
    ];
---

<section class="py-[100px]">
  <div class="max-w-content mx-auto px-7">
    {/* Section header */}
    <div class="mb-14">
      <SectionTag label={t('sectionTags.location')} />
      <h2>{t('location.heading')}</h2>
    </div>

    {/* Map + Detail grid */}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-stretch">
      {/* Google Map */}
      <div class="rounded-lg overflow-hidden border border-line-2 aspect-[4/3]">
        <GoogleMap client:visible />
      </div>

      {/* Detail card */}
      <div class="bg-bg-card border border-line rounded-lg p-10 flex flex-col">
        {/* Address */}
        <div class="py-5 border-b border-line">
          <div class="font-mono text-[0.72rem] uppercase tracking-[0.1em] text-ink-3 mb-1.5">
            {t('location.addressLabel')}
          </div>
          <div class="text-[1.05rem] text-ink">
            3200 Coors Boulevard NW, Suite F<br />Albuquerque, NM 87120
          </div>
        </div>

        {/* Phone */}
        <div class="py-5 border-b border-line">
          <div class="font-mono text-[0.72rem] uppercase tracking-[0.1em] text-ink-3 mb-1.5">
            {t('location.phoneLabel')}
          </div>
          <div class="text-[1.05rem]">
            <a href="tel:+15058771113" class="text-primary-500 no-underline">(505) 877-1113</a>
          </div>
        </div>

        {/* Email */}
        <div class="py-5 border-b border-line">
          <div class="font-mono text-[0.72rem] uppercase tracking-[0.1em] text-ink-3 mb-1.5">
            {t('location.emailLabel')}
          </div>
          <div class="text-[1.05rem]">
            <a href="mailto:emersonvicunadds@gmail.com" class="text-primary-500 no-underline">emersonvicunadds@gmail.com</a>
          </div>
        </div>

        {/* Hours */}
        <div class="py-5">
          <div class="font-mono text-[0.72rem] uppercase tracking-[0.1em] text-ink-3 mb-1.5">
            {t('location.hoursLabel')}
          </div>
          <div class="flex flex-col gap-1 mt-1">
            {days.map(({ day, time, closed }) => (
              <div class:list={["flex justify-between gap-4 text-[0.95rem]", closed ? "text-ink-3" : "text-ink-2"]}>
                <span class="flex-1 min-w-0 whitespace-nowrap">{day}</span>
                <span class="whitespace-nowrap">{time}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
