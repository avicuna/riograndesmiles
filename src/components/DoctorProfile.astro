---
// Homepage "About the doctor" band: bio and credentials on the left; his quote and the practice's
// numbers on the right. The extra top padding leaves room for the quick-action bar, which
// overlaps the top of this band (Hero.astro).
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { getServices } from '../lib/services';
import SectionTag from './SectionTag.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === 'es' ? '/es' : '';
// Counted from src/content/services/, so adding or removing a service keeps this number right.
const serviceCount = (await getServices()).length;

const credentials = [
  t('doctorProfile.credEduValue'),
  t('doctorProfile.credUndergradValue'),
  t('doctorProfile.credMembLong'),
];

const stats = [
  { num: t('trustBar.yearsNum'), label: t('trustBar.yearsLabel'), highlight: true },
  { num: t('trustBar.patientsNum'), label: t('trustBar.patientsLabel') },
  { num: String(serviceCount), label: t('trustBar.servicesLabel') },
  { num: t('trustBar.insuranceNum'), label: t('trustBar.insuranceLabel') },
];

// The heading's last word is highlighted ("Albuquerque.").
const heading = t('doctorProfile.heading');
const split = heading.lastIndexOf(' ');
---

<section id="about" class="bg-primary-700 text-white pt-[120px] pb-20 lg:pt-44 lg:pb-28" aria-labelledby="about-title">
  <div class="max-w-content mx-auto px-5 sm:px-7 grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-11 lg:gap-[72px] items-start">
    <div>
      <SectionTag label={t('sectionTags.doctor')} dark />
      <h2 id="about-title" class="!text-white font-semibold text-[2.375rem] lg:text-[3rem] leading-[1.08]">
        {heading.slice(0, split + 1)}<span class="text-accent-200">{heading.slice(split + 1)}</span>
      </h2>
      <p class="mt-5 mb-6 text-[1.06rem] text-primary-100 leading-relaxed max-w-[560px]">
        {t('doctorProfile.sub')} {t('doctorProfile.practice')}
      </p>
      <ul class="grid gap-3 mb-8" role="list">
        {credentials.map((item) => (
          <li class="flex items-center gap-3 font-medium">
            <span class="grid place-items-center shrink-0 w-6 h-6 rounded-full bg-accent-200 text-primary-900">
              <Icon name="check" class="w-3.5 h-3.5" strokeWidth={2.6} />
            </span>
            {item}
          </li>
        ))}
      </ul>
      <a href={`${prefix}/about/`} class="btn btn-white">{t('doctorProfile.meetButton')}</a>
    </div>

    <div>
      <figure class="m-0 mb-5 bg-primary-900 rounded-3xl px-8 pt-8 pb-7">
        <blockquote class="font-display italic font-medium text-[1.45rem] lg:text-[1.75rem] leading-[1.3] text-white">
          “{t('doctorProfile.quote')}”
        </blockquote>
        <figcaption class="mt-4 text-[0.94rem] text-primary-200">
          <b class="text-white">{t('doctorProfile.quoteBy')}</b>, DDS
        </figcaption>
      </figure>
      <dl class="grid grid-cols-2 gap-4">
        {stats.map((stat) => (
          <div class:list={[
            'flex flex-col-reverse rounded-[20px] px-6 py-[22px] border',
            stat.highlight ? 'bg-accent-200 border-accent-200 text-primary-900' : 'bg-white/[0.08] border-white/20',
          ]}>
            <dt class:list={['mt-2 text-[0.9rem] leading-snug', stat.highlight ? 'text-primary-900' : 'text-primary-100']}>{stat.label}</dt>
            <dd class="m-0 font-sans text-[2.15rem] lg:text-[2.6rem] font-bold tracking-tight leading-none">{stat.num}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
