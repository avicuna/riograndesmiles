---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import ReviewCarousel from './ReviewCarousel';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const reviews = [
  {
    text: "Very professional and following the safest measures. I would recommend this dental place to anyone. Dr. Vicuña and his staff are number 1!",
    author: "Rafael Contreras",
  },
  {
    text: "Very helpful and professional work.",
    author: "Carlos Alvarez",
  },
  {
    text: "Love Dr. Vicuña! He is so gentle and his staff is so friendly. I've been coming here for years and I wouldn't go anywhere else!",
    author: "Clorinda Olguin",
  },
];
---

<section class="bg-neutral-50 py-16 md:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Header */}
    <div class="text-center mb-12">
      <span class="uppercase tracking-wider text-primary-500 text-xs font-semibold">
        {t('reviews.label')}
      </span>
      <h2 class="font-display text-2xl md:text-3xl font-bold text-neutral-900 mt-2">
        {t('reviews.heading')}
      </h2>
    </div>

    <ReviewCarousel reviews={reviews} client:visible />
  </div>
</section>
