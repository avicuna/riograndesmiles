---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import SectionTag from './SectionTag.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const reviews = t.list<{ text: string; author: string; meta: string }>('reviews.items');
---

<section class="bg-ink py-[100px]">
  <div class="max-w-content mx-auto px-7">
    {/* Section header */}
    <div class="grid grid-cols-1 md:grid-cols-[1fr_1.3fr] gap-16 mb-14 items-end">
      <div>
        <SectionTag label={t('sectionTags.reviews')} dark />
        <h2 class="text-bg-card">{t('reviews.heading')}</h2>
      </div>
      <p class="text-bg-card/70 max-w-[56ch] text-[1.05rem]">
        {t('reviews.sub')}
      </p>
    </div>

    {/* Review cards grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map(({ text, author, meta }) => (
        <div class="review-card md:last:col-span-2 lg:last:col-span-1 bg-white/[0.06] border border-white/[0.15] rounded-lg p-8 flex flex-col gap-5">
          {/* Stars */}
          <div class="text-gold tracking-wider text-[0.95rem]">★★★★★</div>

          {/* Quote */}
          <div class="font-display text-[1.15rem] leading-[1.5] text-white/95 font-normal flex-1">
            "{text}"
          </div>

          {/* Author */}
          <div class="flex items-center gap-3 mt-auto pt-5 border-t border-white/[0.15]">
            <div class="w-[38px] h-[38px] rounded-full bg-primary-500 grid place-items-center font-display font-medium text-white text-[0.95rem]">
              {author.charAt(0)}
            </div>
            <div>
              <div class="text-[0.92rem] text-white font-medium">
                {author}
              </div>
              <div class="text-[0.78rem] text-white/50">
                {meta}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
