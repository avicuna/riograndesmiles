---
import type { Locale } from '../i18n/utils';
import BookingFallback from './BookingFallback.astro';
import WeaveScheduler from './WeaveScheduler.tsx';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const showScheduler = import.meta.env.PUBLIC_ENABLE_SCHEDULING === 'true';
---

<div id="booking">
  {showScheduler ? (
    <WeaveScheduler client:visible className="max-w-2xl mx-auto" />
  ) : (
    <BookingFallback locale={locale} />
  )}
</div>
