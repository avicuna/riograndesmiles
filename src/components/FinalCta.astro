---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="bg-neutral-50 py-16 md:py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    {/* Heading */}
    <h2 class="font-display text-2xl md:text-3xl font-bold text-neutral-900 mb-3">
      {t('finalCta.heading')}
    </h2>

    {/* Subtitle */}
    <p class="text-neutral-400 mb-8">
      {t('finalCta.subtitle')}
    </p>

    {/* Buttons */}
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="tel:+5058771113"
        class="inline-flex items-center bg-primary-500 text-white font-semibold rounded-lg px-6 py-3 hover:bg-primary-600 transition-colors shadow-lg"
      >
        {t('finalCta.bookCta')}
      </a>
      <a
        href="tel:+5058771113"
        class="inline-flex items-center border-2 border-primary-500 text-primary-700 font-semibold rounded-lg px-6 py-3 hover:bg-primary-50 transition-colors"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        {t('finalCta.callCta')}
      </a>
    </div>
  </div>
</section>
