---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const providers = [
  { key: 'unitedHealthcare', img: '/img/united-healthcare.png' },
  { key: 'deltaDental', img: '/img/delta-dental.png' },
  { key: 'metlife', img: '/img/metlife.png' },
  { key: 'guardian', img: '/img/guardian.png' },
  { key: 'ameritas', img: '/img/ameritas.png' },
  { key: 'cigna', img: '/img/cigna.png' },
  { key: 'medicaid', img: '/img/medicaid.png' },
  { key: 'principal', img: '/img/principal.png' },
  { key: 'unitedConcordia', img: '/img/united-concordia.png' },
];
---

<section class="bg-neutral-50 py-16 md:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Header */}
    <div class="text-center mb-12">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-neutral-900 mb-3">
        {t('insurance.title')}
      </h2>
      <p class="text-neutral-400 max-w-2xl mx-auto">
        {t('insurance.description')}
      </p>
    </div>

    {/* Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {providers.map((provider) => (
        <div class="bg-white border border-neutral-200 rounded-xl p-4 flex items-center gap-4 hover:shadow-md transition-shadow">
          <img
            src={provider.img}
            alt={t(`insuranceProviders.${provider.key}`)}
            class="w-12 h-12 object-contain flex-shrink-0"
            loading="lazy"
          />
          <span class="text-sm font-medium text-neutral-700">
            {t(`insuranceProviders.${provider.key}`)}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
