---
// Accepted insurance: heading on the left, the plans as chips on the right. Used on the homepage
// and the Insurance page.
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { PHONE_TEL } from '../lib/contact';
import SectionTag from './SectionTag.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Medicaid is listed first, as its own chip.
const providers = ['Delta Dental', 'United Healthcare', 'MetLife', 'Guardian', 'Cigna', 'Ameritas', 'Principal', 'United Concordia'];
---

<section id="insurance" class="py-20 lg:py-28" aria-labelledby="insurance-title">
  <div class="max-w-content mx-auto px-5 sm:px-7 grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-16 items-center">
    <div>
      <SectionTag label={t('sectionTags.insurance')} />
      <h2 id="insurance-title" class="font-semibold text-[2.375rem] lg:text-[2.75rem] leading-[1.1]">{t('insurance.heading')}</h2>
      <p class="mt-4 mb-7 text-[1.06rem] text-ink-2">{t('insurance.sub')}</p>
      <a href={PHONE_TEL} class="btn btn-primary">
        <Icon name="phone" class="w-[18px] h-[18px]" />
        {t('insurance.askButton')}
      </a>
    </div>
    <ul class="flex flex-wrap gap-3" role="list">
      <li class="inline-flex items-center gap-2.5 min-h-[56px] px-[18px] rounded-[14px] border-2 border-accent-400 bg-accent-50 text-accent-700 font-semibold whitespace-nowrap">
        <Icon name="shield" class="w-[18px] h-[18px]" />
        {t('hero.chipMedicaid')}
      </li>
      {providers.map((name) => (
        <li class="inline-flex items-center gap-2.5 min-h-[56px] px-[18px] rounded-[14px] border border-bg-warm bg-white text-ink font-semibold whitespace-nowrap">
          <Icon name="check" class="w-4 h-4 text-accent-700" strokeWidth={2.6} />
          {name}
        </li>
      ))}
    </ul>
  </div>
</section>
