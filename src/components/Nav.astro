---
import type { Locale } from '../i18n/utils';
import { useTranslations, getAlternatePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const homePath = locale === 'es' ? '/es/' : '/';
const alternatePath = getAlternatePath(Astro.url.pathname, locale);

const navLinks = [
  { label: t('navbar.services'), href: '#' },
  { label: t('navbar.about'), href: '#' },
  { label: t('navbar.reviews'), href: '#' },
  { label: t('navbar.insurance'), href: '#' },
  { label: t('navbar.contact'), href: '#' },
];
---

<nav class="sticky top-0 z-50 bg-white border-b border-neutral-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      {/* Logo */}
      <a href={homePath} class="flex-shrink-0">
        <span class="font-display text-xl md:text-2xl font-bold text-primary-700">
          Rio Grande Smiles
        </span>
      </a>

      {/* Desktop nav links */}
      <div class="hidden md:flex items-center space-x-6 lg:space-x-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-neutral-700 hover:text-primary-600 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>

      {/* Right side: phone + book + lang */}
      <div class="flex items-center space-x-3 md:space-x-4">
        {/* Language toggle - desktop */}
        <a
          href={alternatePath}
          class="hidden md:inline-block text-sm font-medium text-neutral-400 hover:text-primary-600 transition-colors"
        >
          {t('navbar.langSwitch')}
        </a>

        {/* Phone */}
        <a
          href="tel:+5058771113"
          class="hidden sm:flex items-center text-sm font-semibold text-neutral-700 hover:text-primary-600 transition-colors"
        >
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          (505) 877-1113
        </a>

        {/* Book Online button */}
        <a
          href="tel:+5058771113"
          class="inline-flex items-center bg-primary-500 text-white text-sm font-semibold rounded-lg px-4 py-2 md:px-5 md:py-2.5 hover:bg-primary-600 transition-colors"
        >
          {t('navbar.book')}
        </a>
      </div>
    </div>
  </div>
</nav>
