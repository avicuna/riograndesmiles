---
import type { Locale } from '../i18n/utils';
import { useTranslations, getAlternatePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const homePath = locale === 'es' ? '/es/' : '/';
const alternatePath = getAlternatePath(Astro.url.pathname, locale);
const alternateLang = locale === 'es' ? 'en' : 'es';
const alternateLangLabel = locale === 'es' ? 'EN' : 'ES';
const currentLangLabel = locale === 'es' ? 'ES' : 'EN';

const prefix = locale === 'es' ? '/es' : '';
const navLinks = [
  { label: t('navbar.about'), href: `${prefix}/about/` },
  { label: t('navbar.services'), href: `${prefix}/services/` },
  { label: locale === 'es' ? 'Nuevos Pacientes' : 'New Patients', href: `${prefix}/new-patients/` },
  { label: t('navbar.insurance'), href: `${prefix}/insurance/` },
  { label: t('navbar.reviews'), href: `${prefix}/reviews/` },
  { label: t('navbar.contact'), href: `${prefix}/contact/` },
];
---

<nav class="nav-bar sticky top-0 z-50 border-b border-line">
  <div class="max-w-content mx-auto px-7">
    <div class="flex items-center justify-between py-3.5">
      {/* Brand */}
      <a href={homePath} class="flex items-center gap-2.5 no-underline">
        <div>
          <div class="font-display text-[1.15rem] font-medium text-ink tracking-tight whitespace-nowrap">
            Rio Grande Smiles
          </div>
          <span class="block font-sans text-[0.7rem] text-ink-3 uppercase tracking-[0.08em] -mt-0.5">
            Dr. Vicuña · DDS
          </span>
        </div>
      </a>

      {/* Desktop nav links */}
      <div class="hidden lg:flex items-center gap-7">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-[0.92rem] text-ink-2 no-underline hover:text-primary-500 transition-colors whitespace-nowrap"
          >
            {link.label}
          </a>
        ))}
      </div>

      {/* Right side: lang toggle + phone CTA */}
      <div class="flex items-center gap-2.5">
        {/* Language toggle pill */}
        <div class="inline-flex items-center gap-0.5 bg-bg-warm border border-line rounded-full p-[3px] text-[0.82rem]">
          <span class="px-3 py-[5px] rounded-full bg-ink text-bg-card font-medium">
            {currentLangLabel}
          </span>
          <a
            href={alternatePath}
            lang={alternateLang}
            class="px-3 py-[5px] rounded-full text-ink-3 font-medium no-underline hover:text-ink transition-colors"
          >
            {alternateLangLabel}
          </a>
        </div>

        {/* Phone CTA */}
        <a
          href="tel:+15058771113"
          class="inline-flex items-center gap-2 bg-primary-500 text-white text-[0.92rem] font-medium rounded-full px-5 py-[11px] no-underline hover:bg-primary-700 transition-all hover:-translate-y-px whitespace-nowrap"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          <span class="hidden sm:inline">(505) 877-1113</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<style>
  .nav-bar {
    background: color-mix(in oklch, var(--c-bg) 85%, transparent);
    backdrop-filter: blur(12px) saturate(1.1);
    -webkit-backdrop-filter: blur(12px) saturate(1.1);
  }
</style>
