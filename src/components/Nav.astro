---
import type { Locale } from '../i18n/utils';
import { useTranslations, getAlternatePath } from '../i18n/utils';
import { PHONE_TEL } from '../lib/contact';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const homePath = locale === 'es' ? '/es/' : '/';
const currentPath = Astro.url.pathname;
// A 404 has no translated twin at the same address, so its toggle goes to the other homepage.
const isNotFound = /^\/(es\/)?404(\/|\.html)?$/.test(currentPath);
const alternatePath = isNotFound ? (locale === 'es' ? '/' : '/es/') : getAlternatePath(currentPath, locale);
const alternateLang = locale === 'es' ? 'en' : 'es';

const prefix = locale === 'es' ? '/es' : '';
const navLinks = [
  { label: t('navbar.services'), href: `${prefix}/services/` },
  { label: t('navbar.about'), href: `${prefix}/about/` },
  { label: t('navbar.newPatients'), href: `${prefix}/new-patients/` },
  { label: t('navbar.insurance'), href: `${prefix}/insurance/` },
  { label: t('navbar.reviews'), href: `${prefix}/reviews/` },
  { label: t('navbar.contact'), href: `${prefix}/contact/` },
].map((link) => ({ ...link, current: currentPath === link.href || currentPath.startsWith(link.href) }));
---

{/* Sticky header. The links show from 1280px; narrower screens get the Menu button.
    The phone button shows from 768px; phones use the fixed Call/Text bar instead (MobileCtaBar). */}
<nav class="sticky top-0 z-50 bg-white border-b border-bg-warm" aria-label={locale === 'es' ? 'Principal' : 'Main'}>
  <div class="relative max-w-content mx-auto px-5 sm:px-7">
    <div class="flex items-center justify-between gap-3 h-[68px] md:h-20">
      {/* Brand */}
      <a href={homePath} class="flex items-center gap-3 no-underline text-ink min-w-0">
        <img src="/brand-tile.svg" alt="" width="42" height="42" class="hidden sm:block shrink-0 w-[42px] h-[42px]" />
        <span class="min-w-0">
          <span class="block font-display text-[1.2rem] sm:text-[1.375rem] font-semibold leading-[1.05] tracking-tight whitespace-nowrap">
            Rio Grande Smiles
          </span>
          <span class="block text-[0.78rem] text-ink-3">{t('navbar.brandSub')}</span>
        </span>
      </a>

      {/* Desktop links (1280px and up) */}
      <div class="hidden xl:flex items-center gap-0.5">
        {navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={link.current ? 'page' : undefined}
            class:list={[
              'inline-flex items-center min-h-[44px] px-3.5 text-[0.94rem] font-medium no-underline whitespace-nowrap transition-colors',
              link.current
                ? 'text-primary-700 shadow-[inset_0_-2px_0_theme(colors.primary.500)]'
                : 'text-ink rounded-lg hover:text-primary-700 hover:bg-primary-50',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      {/* Right side: language, phone, menu */}
      <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
        <a
          href={alternatePath}
          lang={alternateLang}
          hreflang={alternateLang}
          class="inline-flex items-center min-h-[44px] px-4 rounded-full border border-primary-200 text-primary-700 text-[0.9rem] font-semibold no-underline hover:bg-primary-50 transition-colors"
        >
          {t('navbar.langSwitch')}
        </a>

        <a
          href={PHONE_TEL}
          class="hidden md:inline-flex items-center gap-2.5 min-h-[48px] px-5 rounded-xl bg-primary-500 text-white text-[0.94rem] font-semibold no-underline hover:bg-primary-700 transition-colors whitespace-nowrap"
        >
          <Icon name="phone" class="w-[18px] h-[18px]" />
          {t('hero.callButton')}
        </a>

        <button
          type="button"
          data-menu-button
          aria-controls="mobile-menu"
          aria-expanded="false"
          class="xl:hidden inline-flex items-center gap-2 min-h-[48px] min-w-[48px] justify-center px-3 sm:px-4 rounded-xl border border-line text-ink font-semibold hover:bg-primary-50 transition-colors"
        >
          <Icon data-icon-open name="menu" class="w-5 h-5" />
          <Icon data-icon-close name="close" class="w-5 h-5 hidden" />
          <span class="sr-only sm:not-sr-only">{t('navbar.menu')}</span>
        </button>
      </div>
    </div>
  </div>

  {/* Menu panel below 1280px: opened by the menu button */}
  <div id="mobile-menu" class="xl:hidden border-t border-bg-warm bg-white shadow-[0_20px_40px_rgba(15,48,84,0.12)] max-h-[calc(100dvh-4.25rem)] overflow-y-auto" hidden>
    <ul class="max-w-content mx-auto px-5 sm:px-7 py-2">
      {navLinks.map((link) => (
        <li class="border-b border-bg-warm">
          <a
            href={link.href}
            aria-current={link.current ? 'page' : undefined}
            class:list={[
              'flex items-center min-h-[52px] py-2 text-[1.06rem] font-medium no-underline',
              link.current ? 'text-primary-700' : 'text-ink',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href={PHONE_TEL} class="flex items-center gap-2.5 min-h-[52px] py-2 text-[1.06rem] font-semibold text-primary-700 no-underline">
          <Icon name="phone" class="w-[18px] h-[18px]" />
          {t('hero.callButton')}
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const panel = document.getElementById('mobile-menu');
  if (button && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      button.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      button.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    };
    button.addEventListener('click', () => setOpen(panel.hidden));
    panel.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        button.focus();
      }
    });
    // Widening the window to the desktop layout hides the button, so close the panel too.
    window.matchMedia('(min-width: 1280px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
