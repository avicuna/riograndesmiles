---
import type { Locale } from '../i18n/utils';
import { useTranslations, getAlternatePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const homePath = locale === 'es' ? '/es/' : '/';
const currentPath = Astro.url.pathname;
// A 404 has no translated twin at the same address, so its toggle goes to the other homepage.
const isNotFound = /^\/(es\/)?404(\/|\.html)?$/.test(currentPath);
const alternatePath = isNotFound ? (locale === 'es' ? '/' : '/es/') : getAlternatePath(currentPath, locale);
const alternateLang = locale === 'es' ? 'en' : 'es';
const alternateLangLabel = locale === 'es' ? 'EN' : 'ES';
const currentLangLabel = locale === 'es' ? 'ES' : 'EN';

const prefix = locale === 'es' ? '/es' : '';
const navLinks = [
  { label: t('navbar.about'), href: `${prefix}/about/` },
  { label: t('navbar.services'), href: `${prefix}/services/` },
  { label: t('navbar.newPatients'), href: `${prefix}/new-patients/` },
  { label: t('navbar.insurance'), href: `${prefix}/insurance/` },
  { label: t('navbar.reviews'), href: `${prefix}/reviews/` },
  { label: t('navbar.contact'), href: `${prefix}/contact/` },
].map((link) => ({ ...link, current: currentPath === link.href || currentPath.startsWith(link.href) }));
---

<nav class="nav-bar sticky top-0 z-50 border-b border-line" aria-label={locale === 'es' ? 'Principal' : 'Main'}>
  <div class="max-w-content mx-auto px-4 sm:px-7">
    <div class="flex items-center justify-between gap-3 py-3.5">
      {/* Brand */}
      <a href={homePath} class="flex items-center gap-2.5 no-underline min-w-0">
        <div>
          <div class="font-display text-[1.05rem] sm:text-[1.15rem] font-medium text-ink tracking-tight whitespace-nowrap">
            Rio Grande Smiles
          </div>
          <span class="block font-sans text-[0.7rem] text-ink-3 uppercase tracking-[0.08em] -mt-0.5">
            Dr. Vicuña · DDS
          </span>
        </div>
      </a>

      {/* Desktop nav links (1024px and up) */}
      <div class="hidden lg:flex items-center gap-7">
        {navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={link.current ? 'page' : undefined}
            class:list={[
              'text-[0.92rem] no-underline hover:text-primary-500 transition-colors whitespace-nowrap',
              link.current ? 'text-primary-500 font-medium' : 'text-ink-2',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      {/* Right side: language toggle, phone (768px and up; phones use the bottom bar), menu button */}
      <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
        <div class="inline-flex items-center gap-0.5 bg-bg-warm border border-line rounded-full p-[3px] text-[0.82rem]">
          <span class="px-2.5 sm:px-3 py-[5px] rounded-full bg-ink text-bg-card font-medium">
            {currentLangLabel}
          </span>
          <a
            href={alternatePath}
            lang={alternateLang}
            hreflang={alternateLang}
            class="px-2.5 sm:px-3 py-[5px] rounded-full text-ink-3 font-medium no-underline hover:text-ink transition-colors"
          >
            {alternateLangLabel}<span class="sr-only">: {t('navbar.switchLangAria')}</span>
          </a>
        </div>

        <a
          href="tel:+15058771113"
          aria-label={t('navbar.callAria')}
          class="hidden md:inline-flex items-center gap-2 bg-primary-500 text-white text-[0.92rem] font-medium rounded-full px-5 py-[11px] no-underline hover:bg-primary-700 transition-all hover:-translate-y-px whitespace-nowrap"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          (505) 877-1113
        </a>

        <button
          type="button"
          data-menu-button
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label={t('navbar.menu')}
          class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-full border border-line-2 bg-bg-card text-ink hover:bg-bg-warm transition-colors"
        >
          <svg data-icon-open class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg data-icon-close class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Menu panel below 1024px: opened by the menu button */}
  <div id="mobile-menu" class="lg:hidden border-t border-line max-h-[calc(100dvh-4.75rem)] overflow-y-auto" hidden>
    <ul class="max-w-content mx-auto px-4 sm:px-7 py-2">
      {navLinks.map((link) => (
        <li class="border-b border-line last:border-0">
          <a
            href={link.href}
            aria-current={link.current ? 'page' : undefined}
            class:list={[
              'flex items-center min-h-[48px] py-2 text-[1.02rem] no-underline',
              link.current ? 'text-primary-500 font-medium' : 'text-ink',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const panel = document.getElementById('mobile-menu');
  if (button && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      button.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      button.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    };
    button.addEventListener('click', () => setOpen(panel.hidden));
    panel.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        button.focus();
      }
    });
    // Widening the window to the desktop layout hides the button, so close the panel too.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .nav-bar {
    background: color-mix(in oklch, var(--c-bg) 85%, transparent);
    backdrop-filter: blur(12px) saturate(1.1);
    -webkit-backdrop-filter: blur(12px) saturate(1.1);
  }
</style>
