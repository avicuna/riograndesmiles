---
import { serviceIcons, type ServiceIconName } from '../lib/service-icons';

interface Props {
  name: ServiceIconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={serviceIcons[name]}
/>
