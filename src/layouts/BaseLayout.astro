---
import type { Locale } from '../i18n/utils';
import { getAlternatePath } from '../i18n/utils';
import UtilityBar from '../components/UtilityBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MobileCtaBar from '../components/MobileCtaBar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonicalPath: string;
  /** Keep the page out of search results (the 404 pages). */
  noindex?: boolean;
}

const { title, description, locale = 'en', canonicalPath, noindex = false } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://riograndesmiles.com';
// Pages are served with a trailing slash: /about redirects to /about/. Canonical and hreflang
// URLs must name the final address (as the sitemap does), not one that redirects.
const withSlash = (path: string) => (path.endsWith('/') || path.endsWith('.html') ? path : `${path}/`);
const canonicalUrl = `${site}${withSlash(canonicalPath)}`;
const alternateUrl = `${site}${withSlash(getAlternatePath(canonicalPath, locale))}`;
const englishUrl = locale === 'en' ? canonicalUrl : alternateUrl;
const skipLabel = locale === 'es' ? 'Saltar al contenido principal' : 'Skip to main content';
// <body> gets bottom padding on phones so the fixed call bar never covers the end of the footer.
const ogImage = `${site}/og-image.jpg`; // public/og-image.jpg, 1200×630
const ogImageAlt = 'Rio Grande Smiles: Dr. Emerson Vicuña, DDS, Albuquerque, NM';
// Cloudflare Web Analytics (see "Analytics" in the README). Netlify sets CONTEXT to "production" only
// when it builds the live site, so deploy previews and local builds don't count as visits.
const loadAnalytics = process.env.CONTEXT === 'production';
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Site icon (see "Site Icon" in the README). Browsers that read SVG use favicon.svg; the
        sizes on the .ico keep Chrome from choosing it over the SVG. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Rio Grande" />

    {/* Fonts — self-hosted via @fontsource (imported in global.css) */}
    <meta name="theme-color" content="#186db9" />

    {/* SEO */}
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang={locale === 'en' ? 'es' : 'en'} href={alternateUrl} />
        <link rel="alternate" hreflang={locale} href={canonicalUrl} />
        <link rel="alternate" hreflang="x-default" href={englishUrl} />
      </>
    )}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {loadAnalytics && (
      <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "cff4d76671a843a5bc0b7029eaadaa9a"}'></script>
    )}
  </head>
  <body class="font-sans text-ink-2 bg-bg pb-[74px] md:pb-0">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-primary-500 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold">
      {skipLabel}
    </a>
    <UtilityBar locale={locale} />
    <Nav locale={locale} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
    <MobileCtaBar locale={locale} />
  </body>
</html>
